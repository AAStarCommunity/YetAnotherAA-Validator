# Price keeper entry "op-sepolia": OP Sepolia (11155420), SuperPaymaster v5.5.0-rc.8 (deploy commit 99a38d8d).
# Non-secret settings only. install.sh copies this file to ~/.config/aastar-price-keeper-op-sepolia/entry.env;
# run.sh and status.mjs read it there. Never put RPC_URL, a key or a token in this file (run.sh refuses).
KEEPER_ENTRY=op-sepolia
KEEPER_NETWORK=op-sepolia
# aastar-sdk worktree that holds scripts/keeper.ts (detached at dab087cc, #456). "~/" is the keeper's home.
KEEPER_SDK_DIR="~/Dev/aastar/aastar-sdk-price-keeper-next"
# SuperPaymaster proxy; version() "SuperPaymaster-5.5.3", REGISTRY() 0x4b71DB19fBA1a506E0b8ee729B6DC2001Aa19895
KEEPER_SUPERPAYMASTER=0x3c73dd3c576a594dd1e7afdeec9f8757c35a31e7
# Empty: this deployment has no PaymasterV4 instance, and run.sh passes --no-paymaster. Leaving --paymaster
# out instead would make keeper.ts fall back to the SDK's canonical OP Sepolia V4 from an abandoned deployment.
KEEPER_PAYMASTER=
KEEPER_HARD_MAX_FEE_GWEI=2
# status.mjs reports LOW_GAS below this. updatePrice uses ~74k gas at ~0.0000003 gwei on OP Sepolia.
KEEPER_MIN_BALANCE_WEI=1000000000000000
