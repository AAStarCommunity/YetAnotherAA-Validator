<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces @ENTRY@ and @HOME@ and writes ~/Library/LaunchAgents/io.aastar.price-keeper-@ENTRY@-stale-watch.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.aastar.price-keeper-@ENTRY@-stale-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@HOME@/.config/aastar-price-keeper-@ENTRY@/stale-watch.sh</string>
  </array>
  <!-- Top-level keys. Nested inside another dict, StartInterval passes plutil -lint and launchd ignores it. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/aastar-price-keeper-@ENTRY@-stale-watch.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/aastar-price-keeper-@ENTRY@-stale-watch.log</string>
</dict>
</plist>
