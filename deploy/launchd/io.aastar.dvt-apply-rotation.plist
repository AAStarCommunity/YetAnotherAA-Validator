<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CC-115 B3: finalise the verifier rotation the day its four-day delay matures (2026-09-04
     05:36:24Z). applyFraudProofVerifier() is permissionless and takes no arguments, so this can only
     finalise the verifier the aggregator owner already proposed and that has already served its full
     delay -- there is no decision left to make. Running it before readyAt exits 0 with a countdown
     and sends nothing.

     WHY LOCAL AND NOT THE WORKFLOW: .github/workflows/apply-verifier-rotation.yml exists and is
     correct, but `schedule` does not fire in this repo (measured; see local-heartbeat.sh). Without
     this job the last link in the chain is a human remembering on the day -- which is the exact risk
     that PR was written to remove.

     Hourly, not daily: readyAt is 05:36Z and a laptop is not always awake at a given hour. Every run
     before maturity is a cheap read that exits 0.

     Install and verify: deploy/README-heartbeat.md -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.aastar.dvt-apply-rotation</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jason/Dev/aastar/YetAnotherAA-Validator/deploy/local-heartbeat.sh</string>
    <string>apply</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jason/Dev/aastar/YetAnotherAA-Validator</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/jason/.nvm/versions/node/v22.22.2/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/jason</string>
  </dict>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jason/Dev/aastar/YetAnotherAA-Validator/deploy/.run/launchd-apply-rotation.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jason/Dev/aastar/YetAnotherAA-Validator/deploy/.run/launchd-apply-rotation.log</string>
</dict>
</plist>
